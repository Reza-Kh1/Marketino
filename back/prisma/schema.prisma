// update with migration ==>
// npx prisma format
// npx prisma migrate dev --name add_wallet_returns_shipping
// npx prisma generate
// npx prisma migrate reset 
// npx prisma db push --force-reset
// in product ==> npx prisma migrate deploy
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  email          String    @unique
  password       String?
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  phone          String?
  avatar         String?
  role           UserRole  @default(buyer)
  permissions    String?
  createdBy      String?   @map("created_by")
  isActive       Boolean   @default(true) @map("is_active")
  isVerified     Boolean   @default(false) @map("is_verified")
  emailVerified  Boolean   @default(false) @map("email_verified")
  hasSetPassword Boolean   @default(true) @map("has_set_password")
  googleId       String?   @unique @map("google_id")
  language       String    @default("fa")
  lastLogin      DateTime? @map("last_login")
  resetToken     String?   @map("reset_token")
  resetExpires   DateTime? @map("reset_expires")
  verifyToken    String?   @map("verify_token")
  verifyExpires  DateTime? @map("verify_expires")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  addresses            Address[]
  cartItems            CartItem[]
  orders               Order[]
  reviews              Review[]            @relation("ReviewUser")
  reviewAnswers        Review[]            @relation("ReviewAnswer")
  storeReview          StoreReview[]
  ticket               Ticket[]
  createdAdmins        User[]              @relation("AdminCreatedBy")
  creator              User?               @relation("AdminCreatedBy", fields: [createdBy], references: [id])
  walletTransactions   WalletTransaction[]
  wallet               Wallet?
  wishlistItems        WishlistItem[]
  qnas                 Qna[]
  store                Store?
  returnRequests       ReturnRequest[]
  bankAccounts         BankAccount[]
  discountCodesCreated DiscountCode[]      @relation("DiscountCodeCreator")
  ticketMessages       TicketMessage[]
  checkouts            Checkout[]

  buyerConversations  Conversation[] @relation("ConversationBuyer")
  sellerConversations Conversation[] @relation("ConversationSeller")
  receivedMessages    Message[]      @relation("ReceivedMessages")
  sentMessages        Message[]      @relation("SentMessages")
  blogPosts           BlogPost[]
  compareItems        CompareItem[]
  notifications       Notification[]

  @@map("users")
}

model Store {
  id               String      @id @default(uuid())
  ownerId          String      @unique @map("owner_id") // اگه بعداً خواستی multi-store بشه، unique رو بردار
  name             String      @map("name")
  nameEn           String?     @map("name_en")
  slug             String      @unique @map("slug")
  logo             String?     @map("logo")
  banner           String?     @map("banner")
  description      String?     @map("description")
  descriptionEn    String?     @map("description_en")
  businessType     String?     @map("business_type") // حقیقی / حقوقی
  nationalId       String?     @map("national_id") // کد ملی یا شناسه ملی
  economicCode     String?     @map("economic_code")
  commissionRate   Decimal     @default(0) @map("commission_rate") @db.Decimal(12, 2)
  status           StoreStatus @default(pending) @map("status")
  statusReason     String?     @map("status_reason")
  isActive         Boolean     @default(false) @map("is_active")
  isVerified       Boolean     @default(false) @map("is_verified")
  address          String?     @map("address")
  phone            String?     @map("phone")
  email            String?     @map("email")
  instagram        String?     @map("instagram")
  telegram         String?     @map("telegram")
  whatsApp         String?     @map("whats_app")
  bale             String?     @map("bale")
  robika           String?     @map("robika")
  shippingTime     String?     @map("shipping_time")
  taxRate          Decimal     @default(9) @map("tax_rate") @db.Decimal(5, 2)
  workingHours     String?     @map("working_hours")
  hasPhysicalStore Boolean     @default(false) @map("has_physical_store")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  provinceId String?  @map("province_id")
  cityId     String?  @map("city_id")

  province             Province?             @relation(fields: [provinceId], references: [id])
  city                 City?                 @relation(fields: [cityId], references: [id])
  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products             Product[]
  rating               StoreRating?
  storeReview          StoreReview[]
  orders               Order[]
  orderItems           OrderItem[]
  discountCodeStores   DiscountCodeStore[]
  storeShippingMethods StoreShippingMethod[]

  @@index([isActive, isVerified])
  @@index([isActive, isVerified, name])
  @@map("stores")
}

model StoreRating {
  id           String @id @default(uuid())
  avgRating    Float  @default(0) @map("avg_rating")
  ratingTotal  Float  @default(0) @map("rating_total")
  totalReviews Int    @default(0) @map("total_reviews")

  productCount        Int   @default(0) @map("product_count")
  productQuality      Float @default(5) @map("product_quality")
  productQualityTotal Float @default(0) @map("product_quality_total")
  productQualityCount Int   @default(0) @map("product_quality_count")

  totalResponseRequests Int   @default(0) @map("total_response_requests")
  answeredResponses     Int   @default(0) @map("answered_responses")
  totalResponseTime     Float @default(0) @map("total_response_time")
  responseRate          Float @default(100) @map("response_rate")
  responseTime          Float @default(0) @map("response_time")

  saleCount   Int      @default(0) @map("sale_count")
  returnCount Int      @default(0) @map("return_count")
  updatedAt   DateTime @updatedAt @map("updated_at")

  storeId String @unique @map("seller_id")
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([avgRating])
  @@index([totalReviews])
  @@index([productQuality])
  @@index([answeredResponses])
  @@index([responseRate])
  @@index([responseTime])
  @@index([saleCount])
  @@map("store_ratings")
}

model Category {
  id                   String                @id @default(uuid())
  name                 String
  nameEn               String?               @map("name_en")
  slug                 String                @unique
  slugEn               String?               @unique @map("slug_en")
  parentId             String?               @map("parent_id")
  icon                 String?
  image                String?
  ancestorIds          String[]              @default([])
  sortOrder            Int                   @default(0) @map("sort_order")
  isActive             Boolean               @default(true) @map("is_active")
  metaTitle            String?               @map("meta_title")
  metaTitleEn          String?               @map("meta_title_en")
  metaDescription      String?               @map("meta_description")
  metaDescriptionEn    String?               @map("meta_description_en")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  parent               Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children             Category[]            @relation("CategoryTree")
  products             Product[]
  attributeDefinitions AttributeDefinition[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  nameEn      String?
  sortOrder   Int?      @default(0)
  slug        String    @unique
  logo        String?
  description String?
  products    Product[]

  @@map("brands")
}

model Product {
  id              String           @id @default(uuid())
  title           String           @map("title")
  titleEn         String?          @map("title_en")
  slug            String           @unique @map("slug")
  slugEn          String?          @unique @map("slug_en")
  metaTitle       String?          @map("meta_title")
  metaTitleEn     String?          @map("meta_title_en")
  content         Json?            @map("content")
  contentEn       Json?            @map("content_en")
  description     String           @map("description")
  descriptionEn   String?          @map("description_en")
  originalPrice   Decimal?         @map("original_price") @db.Decimal(12, 2)
  minPrice        Decimal?         @map("min_Price") @db.Decimal(12, 2)
  discountPercent String?          @map("discount_percent")
  condition       ProductCondition @default(new)
  status          ProductStatus    @default(pending)
  isFeatured      Boolean          @default(false) @map("is_featured")
  isDigital       Boolean          @default(false) @map("is_digital")
  digitalFile     String?          @map("digital_file")
  viewCount       Int              @default(0) @map("view_count")
  saleCount       Int              @default(0) @map("sale_count")
  rating          Float            @default(0)
  reviewCount     Int              @default(0) @map("review_count")
  productTable    Json?            @map("product_table")
  productTableEn  Json?            @map("product_table_en")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  categoryId      String           @map("category_id")
  brandId         String?          @map("brand_id")
  storeId         String?          @map("store_id")

  cartItems     CartItem[]
  compareItems  CompareItem[]
  conversations Conversation[]
  orderItems    OrderItem[]
  images        ProductImage[]
  variants      ProductVariant[]
  brand         Brand?           @relation(fields: [brandId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  reviews       Review[]
  wishlistItems WishlistItem[]
  qnas          Qna[]
  store         Store?           @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([slug, slugEn])
  @@index([minPrice])
  @@index([saleCount])
  @@index([rating])
  @@index([updatedAt])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  name       String   @map("name")
  nameEn     String?  @map("name_en")
  sku        String?  @unique @map("sku")
  price      Decimal? @map("price") @db.Decimal(12, 2)
  quantity   Int      @default(0) @map("quantity")
  colorId    String?  @map("color_id")
  image      String?  @map("image")
  saleCount  Int      @default(0) @map("sale_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  discountId String?  @map("discount_id")
  productId  String   @map("product_id")

  cartItems  CartItem[]
  orderItems OrderItem[]
  attributes VariantAttributeValue[]
  discount   DiscountCode?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  color      Color?                  @relation(fields: [colorId], references: [id], onDelete: SetNull)
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model AttributeDefinition {
  id       String     @id @default(cuid())
  key      String     @unique @map("key")
  label    String     @map("label")
  category Category[]

  values VariantAttributeValue[]
}

model VariantAttributeValue {
  id          String              @id @default(cuid())
  value       String              @map("value")
  valueEn     String?             @map("value_en")
  variantId   String              @map("variant_id")
  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId String              @map("attribute_id")
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@index([attributeId, value])
}

model Color {
  id              String           @id @default(uuid())
  name            String           @map("name")
  nameEn          String           @map("name_en")
  hexCode         String           @map("hex_code")
  slug            String           @unique @map("slug")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  productVariants ProductVariant[]
}

model ProductImage {
  id              String         @id @default(uuid())
  url             String         @unique
  alt             String?
  useCase         ImageUseCase   @default(PRODUCT) @map("use_case")
  sortOrder       Int            @default(0) @map("sort_order")
  isMain          Boolean        @default(false) @map("is_main")
  createdAt       DateTime       @default(now()) @map("created_at")
  productId       String?        @map("product_id")
  reportsId       String?
  ticketMessageId String?
  returnRequestId String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reports         Reports?       @relation(fields: [reportsId], references: [id])
  ticketMessage   TicketMessage? @relation(fields: [ticketMessageId], references: [id])
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model CartItem {
  id       String @id @default(uuid())
  quantity Int    @default(1)

  userId    String         @map("user_id")
  productId String         @map("product_id")
  variantId String         @map("variant_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

model Address {
  id         String     @id @default(uuid())
  title      String?
  fullName   String     @map("full_name")
  phone      String
  provinceId String
  cityId     String
  address    String
  postalCode String?    @map("postal_code")
  isDefault  Boolean    @default(false) @map("is_default")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  checkouts  Checkout[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique @map("order_number")
  status           OrderStatus @default(pending) @map("status")
  shippingCost     Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  shippingName     String?     @map("shipping_name")
  storeName        String      @map("store_name")
  storeNameEn      String      @map("store_name_en")
  commission       Decimal     @map("commission") @db.Decimal(12, 2)
  commissionAmount Decimal     @default(0) @map("commission_amount") @db.Decimal(12, 2)
  subtotal         Decimal     @map("subtotal") @db.Decimal(13, 2)
  totalPrice       Decimal     @map("total_price") @db.Decimal(13, 2)
  discountAmount   Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  note             String?     @map("note")

  trackingCode          String?              @map("tracking_code")
  deliveredAt           DateTime?            @map("delivered_at")
  cancelledAt           DateTime?            @map("cancelled_at")
  returnDeadline        DateTime?            @map("return_deadline")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  storeShippingMethodId String?              @map("shipping_method_id")
  checkoutId            String               @map("checkout_id")
  storeId               String               @map("store_id")
  discountCodeId        String?              @map("discount_code_id")
  userId                String               @map("user_id")
  checkout              Checkout             @relation(fields: [checkoutId], references: [id])
  store                 Store                @relation(fields: [storeId], references: [id])
  user                  User                 @relation(fields: [userId], references: [id]) // نگه دار برای کوئری سریع‌تر
  items                 OrderItem[]
  invoice               Invoice?
  returnRequests        ReturnRequest[]
  ticket                Ticket?
  trackingEvents        TrackingEvent[]
  storeShippingMethod   StoreShippingMethod? @relation(fields: [storeShippingMethodId], references: [id])
  discountCode          DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  walletTransactions    WalletTransaction[]

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([checkoutId])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  sku           String   @map("sku")
  name          String   @map("name")
  nameEn        String   @map("name_en")
  price         Decimal  @map("price") @db.Decimal(12, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(12, 2)
  total         Decimal  @map("total") @db.Decimal(13, 2)
  quantity      Int      @map("quantity")
  returnedQty   Int?     @default(0) @map("returned_qty")
  attributes    Json?    @map("attributes")
  colorName     String?  @map("color_name")
  colorHex      String?  @map("color_hex")

  orderId     String         @map("order_id")
  productId   String         @map("product_id")
  storeId     String         @map("store_id")
  variantId   String         @map("variant_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  store       Store          @relation(fields: [storeId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([storeId])
  @@map("order_items")
}

model Checkout {
  id               String  @id @default(uuid())
  checkoutNumber   String  @unique @map("checkout_number")
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(13, 2)
  salesProfit      Decimal @default(0) @map("sales_profit") @db.Decimal(13, 2)
  totalAmount      Decimal @map("total_amount") @db.Decimal(13, 2)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(13, 2)

  discountStatus   StatusDiscount? @map("discount_status")
  paymentStatus    PaymentStatus   @default(pending) @map("payment_status")
  paymentMethod    PaymentMethod?  @map("payment_method")
  paymentRef       String?         @map("payment_ref")
  shippingName     String          @map("shipping_name")
  shippingPhone    String          @map("shipping_phone")
  shippingCity     String          @map("shipping_city")
  shippingProvince String          @map("shipping_province")
  shippingAddress  String          @map("shipping_address")
  shippingPostal   String          @map("shipping_postal")

  discountId String?       @map("discount_id")
  userId     String        @map("user_id")
  addressId  String?       @map("address_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  user       User          @relation(fields: [userId], references: [id])
  address    Address?      @relation(fields: [addressId], references: [id])
  discount   DiscountCode? @relation(fields: [discountId], references: [id])
  orders     Order[]
  payments   Payment[]

  @@index([userId])
  @@map("checkouts")
}

model Payment {
  id           String        @id @default(uuid())
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  status       PaymentStatus @default(pending)
  gatewayRef   String?       @map("gateway_ref")
  authority    String?
  errorMessage String?       @map("error_message")
  paidAt       DateTime?     @map("paid_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  checkoutId   String        @map("checkout_id")
  checkout     Checkout      @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  amount        Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(pending)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  orderId       String        @unique @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

model ReturnRequest {
  id                 String        @id @default(uuid())
  requestNumber      String        @unique @map("request_number")
  orderId            String        @map("order_id")
  userId             String        @map("user_id")
  status             ReturnStatus  @default(requested)
  reason             String        @map("reason")
  reasonDetail       String?       @map("reason_detail")
  refundMethod       RefundMethod? @map("refund_method")
  refundAmount       Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  returnShippingCost Decimal?      @map("return_shipping_cost") @db.Decimal(12, 2)
  adminNote          String?       @map("admin_note")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  resolvedAt         DateTime?     @map("resolved_at")

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id])
  items              ReturnItem[]
  images             ProductImage[]
  walletTransactions WalletTransaction[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String   @id @default(uuid())
  returnRequestId String   @map("return_request_id")
  orderItemId     String   @map("order_item_id")
  quantity        Int
  reason          String?
  condition       String? // سالم / آسیب‌دیده / بازکرده و... برای بررسی انبار فروشنده
  unitRefund      Decimal? @map("unit_refund") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_items")
}

model Review {
  id               String   @id @default(uuid())
  rating           Int
  title            String?
  body             String
  answerReview     String?  @map("answer_review")
  answerId         String?  @map("answer_id")
  isApproved       Boolean  @default(false) @map("is_approved")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  verifiedPurchase Boolean  @default(false)
  variantInfo      Json?    @map("variant_info")
  userId           String   @map("user_id")
  productId        String   @map("product_id")
  orderId          String?  @map("order_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation("ReviewUser", fields: [userId], references: [id])
  answer  User?   @relation("ReviewAnswer", fields: [answerId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@index([answerId])
  @@map("reviews")
}

model StoreReview {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  verifiedPurchase Boolean     @default(false)
  rating           Int         @map("rating")
  body             String?     @map("body")
  productQuality   Int?        @map("product_quality")
  productName      String?     @map("product_name")
  status           StoreStatus @default(pending) @map("status")
  answerReview     String?     @map("answer_review")
  answerAt         DateTime?   @map("answer_at")
  responseAt       DateTime?   @map("response_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storeId String @map("store_id")

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@map("store_reviews")
}

model WishlistItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Notification {
  id            String           @id @default(uuid())
  type          NotificationType
  title         String
  body          String
  link          String?
  referenceType String?          @map("reference_type")
  referenceId   String?          @map("reference_id")
  isRead        Boolean          @default(false) @map("is_read")
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Wallet {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  balance         Decimal @default(0) @db.Decimal(18, 2)
  pendingBalance  Decimal @default(0) @map("pending_balance") @db.Decimal(18, 2)
  withdrawBalance Decimal @default(0) @map("withdraw_balance") @db.Decimal(18, 2)
  frozenBalance   Decimal @default(0) @map("frozen_balance") @db.Decimal(18, 2)
  isPlatform      Boolean @default(false) @map("is_platform")

  bankAccountId String?             @map("bank_account_id")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
  bankAccounts  BankAccount[]

  @@map("wallets")
}

model WalletTransaction {
  id           String                  @id @default(uuid())
  type         WalletTransactionType   @map("type")
  status       WalletTransactionStatus @default(completed)
  amount       Decimal                 @map("amount") @db.Decimal(18, 2)
  trackingCode String                  @unique @map("tracking_code")
  description  String?                 @map("description")

  userId          String    @map("user_id")
  walletId        String    @map("wallet_id")
  orderId         String?   @map("order_id")
  returnRequestId String?   @map("return_request_id")
  SettlementDate  DateTime? @map("settlement_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([type, status])
  @@index([orderId])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model BankAccount {
  id            String  @id @default(uuid())
  bankName      String? @map("bank_name")
  accountHolder String  @map("account_holder")
  iban          String  @map("iban")
  cardNumber    String? @map("card_number")
  isDefault     Boolean @default(false) @map("is_default")
  isVerified    Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  walletId  String?  @map("wallet_id")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bank_accounts")
}

model DiscountCode {
  id             String         @id @default(uuid())
  code           String         @unique @map("code")
  type           DiscountType   @default(percentage) @map("type")
  status         StatusDiscount @default(PRODUCT)
  value          Decimal        @map("value") @db.Decimal(12, 2)
  minOrderAmount Decimal        @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?       @map("max_discount") @db.Decimal(12, 2)
  usageLimit     Int            @default(0) @map("usage_limit")
  usedCount      Int            @default(0) @map("used_count")
  perUserLimit   Int            @default(0) @map("per_user_limit")
  startsAt       DateTime       @map("starts_at")
  endsAt         DateTime       @map("ends_at")
  isActive       Boolean        @default(true) @map("is_active")
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  creatorId      String?        @map("creator_id")

  usages             DiscountCodeUsage[]
  creator            User?               @relation("DiscountCodeCreator", fields: [creatorId], references: [id])
  orders             Order[]
  productVariants    ProductVariant[]
  checkouts          Checkout[]
  discountCodeStores DiscountCodeStore[]

  @@index([creatorId])
  @@map("discount_codes")
}

model DiscountCodeStore {
  discountCodeId String
  storeId        String

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([discountCodeId, storeId])
  @@index([storeId])
  @@map("discount_code_stores")
}

model DiscountCodeUsage {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now()) @map("created_at")
  discountCodeId String       @map("discount_code_id")
  userId         String       @map("user_id")
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(12, 2)

  @@index([discountCodeId])
  @@index([userId])
  @@map("discount_code_usages")
}

model ShippingMethod {
  id           String  @id @default(uuid())
  name         String  @map("name")
  nameEn       String? @map("name_en")
  isFreeMethod Boolean @default(false) @map("is_free_method")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storeShippingMethods StoreShippingMethod[]

  @@index([isActive])
  @@map("shipping_methods")
}

model StoreShippingMethod {
  id            String   @id @default(uuid())
  isActive      Boolean  @default(true) @map("is_active")
  description   String?  @map("description")
  descriptionEn String?  @map("description_en")
  phrase        String?  @map("phrase")
  minDays       Int      @map("min_days")
  maxDays       Int      @map("max_days")
  defaultPrice  Decimal? @map("default_price") @db.Decimal(12, 2)

  storeId          String
  shippingMethodId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod      @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  rates          StoreShippingRate[]
  orders         Order[]

  @@unique([storeId, shippingMethodId])
  @@index([storeId])
  @@index([shippingMethodId])
  @@map("store_shipping_methods")
}

model StoreShippingRate {
  id              String  @id @default(uuid())
  price           Decimal @map("price") @db.Decimal(12, 2)
  deliveryMaxDays Int     @map("return_days")

  storeShippingMethodId String
  provinceId            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  storeShippingMethod StoreShippingMethod @relation(fields: [storeShippingMethodId], references: [id], onDelete: Cascade)
  province            Province            @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@unique([storeShippingMethodId, provinceId])
  @@index([provinceId])
  @@map("store_shipping_rates")
}

model Province {
  id     String  @id @default(uuid())
  name   String  @unique @map("name")
  nameEn String? @map("name_en")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cityes             City[]
  store              Store[]
  storeShippingRates StoreShippingRate[]
  addresses          Address[]

  @@map("provinces")
}

model City {
  id     String  @id @default(uuid())
  name   String  @map("name")
  nameEn String? @map("name_en")

  provinceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  province   Province  @relation(fields: [provinceId], references: [id])
  store      Store[]
  addresses  Address[]

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("cities")
}

model Ticket {
  id             String          @id @default(uuid())
  status         TicketStatus    @default(PENDING)
  priority       TicketPriority
  title          String
  trackingCode   String
  isUserRead     Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  userId         String          @map("user_id")
  orderId        String?         @unique @map("order_id") // ✅ unique می‌ماند
  ticketMessages TicketMessage[]
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("tickets")
}

model TicketMessage {
  id        String         @id @default(cuid())
  content   String
  ticketId  String
  senderId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  images    ProductImage[]
  sender    User           @relation(fields: [senderId], references: [id])
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("ticket_messages")
}

model Reports {
  id           String         @id @default(uuid())
  nameSeller   String?
  content      String
  title        String
  orderCode    String?
  trackingCode String?
  status       ReportsStatus  @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  images       ProductImage[]

  @@index([status])
  @@map("reports")
}

model Qna {
  id        String         @id @default(uuid())
  content   String
  role      UserRole       @default(buyer)
  status    ReviewApproval @default(pending)
  userId    String
  parentId  String?
  productId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  parent  Qna?    @relation("QnaReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Qna[]   @relation("QnaReplies")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@index([parentId])
  @@index([createdAt])
  @@map("qna")
}

model BlogPost {
  id                String         @id @default(uuid())
  title             String
  titleEn           String?        @map("title_en")
  slug              String         @unique
  slugEn            String?        @unique @map("slug_en")
  excerpt           String?
  excerptEn         String?        @map("excerpt_en")
  content           String
  contentEn         String?        @map("content_en")
  image             String?
  tags              String?
  status            BlogPostStatus @default(draft)
  publishedAt       DateTime?      @map("published_at")
  viewCount         Int            @default(0) @map("view_count")
  metaTitle         String?        @map("meta_title")
  metaTitleEn       String?        @map("meta_title_en")
  metaDescription   String?        @map("meta_description")
  metaDescriptionEn String?        @map("meta_description_en")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  authorId          String         @map("author_id")
  author            User           @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model Banner {
  id         String         @id @default(uuid())
  title      String
  titleEn    String?        @map("title_en")
  subtitle   String?
  subtitleEn String?        @map("subtitle_en")
  image      String
  link       String?
  position   BannerPosition @default(home_top)
  isActive   Boolean        @default(true) @map("is_active")
  sortOrder  Int            @default(0) @map("sort_order")
  startsAt   DateTime?      @map("starts_at")
  endsAt     DateTime?      @map("ends_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@map("banners")
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("string")

  @@map("site_settings")
}

model OtpCode {
  id        String     @id @default(uuid())
  contact   String
  code      String
  type      OtpType
  purpose   OtpPurpose @default(auth)
  used      Boolean    @default(false)
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([contact])
  @@index([expiresAt])
  @@map("otp_codes")
}

model TrackingEvent {
  id          String         @id @default(uuid())
  status      TrackingStatus
  location    String?
  description String
  createdAt   DateTime       @default(now()) @map("created_at")
  orderId     String         @map("order_id")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("tracking_events")
}

model CompareItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("compare_items")
}

model Conversation {
  id            String    @id @default(uuid())
  subject       String?
  lastMessage   String?   @map("last_message")
  lastMessageAt DateTime? @map("last_message_at")
  isRead        Boolean   @default(false) @map("is_read")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  productId     String?   @map("product_id")
  buyerId       String    @map("buyer_id")
  sellerId      String    @map("seller_id")
  buyer         User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  product       Product?  @relation(fields: [productId], references: [id])
  seller        User      @relation("ConversationSeller", fields: [sellerId], references: [id])
  messages      Message[]

  @@index([buyerId])
  @@index([sellerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  text           String
  isRead         Boolean      @default(false) @map("is_read")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  receiverId     String       @map("receiver_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

enum StatusDiscount {
  PLATFORM
  STORE
  COMMISSION
  PRODUCT
}

enum UserRole {
  buyer
  seller
  admin
  superAdmin
}

enum StoreStatus {
  pending
  approved
  rejected
}

enum ProductCondition {
  new
  used
}

enum ProductStatus {
  pending
  approved
  inactive
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
}

enum PaymentStatus {
  pending
  paid
  refunded
}

enum PaymentMethod {
  card
  wallet
  cod
  zarinpal
}

enum ReviewApproval {
  approved
  pending
  rejected
}

enum DiscountType {
  percentage
  fixed
}

enum NotificationType {
  order
  message
  system
  seller
  promotion
}

enum WalletTransactionType {
  deposit // واریز
  withdraw // برداشت
  commission // کمیسیون
  tax // مالیات
  refund // بازگشت وجه
  purchase // خرید
  // واریز خودکار به فروشنده بابت تسویه‌ی یک سفارش
  sale_settlement
  // کسر از کیف‌پول فروشنده بابت مرجوعی کالا
  return_deduction
}

enum WalletTransactionStatus {
  pending
  completed
  failed
}

enum PayoutStatus {
  pending
  approved
  rejected
  failed
}

enum ReturnStatus {
  requested
  approved
  rejected
  item_received
  refunded
  closed
}

enum RefundMethod {
  wallet
  original_payment
}

enum BlogPostStatus {
  draft
  published
}

enum BannerPosition {
  home_top
  home_middle
  sidebar
  mobile
}

enum OtpType {
  email
  phone
}

enum OtpPurpose {
  auth
  reset
}

enum TrackingStatus {
  pending
  processing
  shipped
  in_transit
  delivered
}

enum InvoiceStatus {
  pending
  paid
  cancelled
}

enum TicketStatus {
  PENDING
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum ReportsStatus {
  PENDING
  RESOLVED
  CLOSED
}

enum ImageUseCase {
  AVATAR
  PRODUCT
  POST
  ATTACHMENT
  THUMBNAIL
  WATERMARK
  REPORTS
  MAINS
}
