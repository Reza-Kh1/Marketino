generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  username             String              @unique
  email                String              @unique
  password             String?
  firstName            String?             @map("first_name")
  lastName             String?             @map("last_name")
  phone                String?
  avatar               String?
  role                 UserRole            @default(buyer)
  isSuperAdmin         Boolean             @default(false) @map("is_super_admin")
  permissions          String?
  createdBy            String?             @map("created_by")
  sellerStatus         SellerStatus?       @map("seller_status")
  sellerReason         String?             @map("seller_reason")
  businessType         String?             @map("business_type")
  commissionRate       Float               @default(0) @map("commission_rate")
  storeName            String?             @map("store_name")
  storeLogo            String?             @map("store_logo")
  storeDescription     String?             @map("store_description")
  storeDescriptionEn   String?             @map("store_description_en")
  isActive             Boolean             @default(true) @map("is_active")
  isVerified           Boolean             @default(false) @map("is_verified")
  emailVerified        Boolean             @default(false) @map("email_verified")
  hasSetPassword       Boolean             @default(true) @map("has_set_password")
  googleId             String?             @unique @map("google_id")
  language             String              @default("fa")
  lastLogin            DateTime?           @map("last_login")
  resetToken           String?             @map("reset_token")
  resetExpires         DateTime?           @map("reset_expires")
  verifyToken          String?             @map("verify_token")
  verifyExpires        DateTime?           @map("verify_expires")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  addresses            Address[]
  blogPosts            BlogPost[]
  cartItems            CartItem[]
  compareItems         CompareItem[]
  buyerConversations   Conversation[]      @relation("ConversationBuyer")
  sellerConversations  Conversation[]      @relation("ConversationSeller")
  discountCodes        DiscountCode[]      @relation("DiscountCodeCreator")
  sellerDiscounts      DiscountCode[]
  receivedMessages     Message[]           @relation("ReceivedMessages")
  sentMessages         Message[]           @relation("SentMessages")
  notifications        Notification[]
  sellerOrderItems     OrderItem[]
  orders               Order[]
  products             Product[]
  reviews              Review[]
  sellerRating         SellerRating?
  sellerReviews        SellerReview[]      @relation("SellerReviews")
  sellerReviewReceived SellerReview[]      @relation("SellerReviewed")
  ticketMessages       TicketMessage[]
  ticket               Ticket[]
  creator              User?               @relation("AdminCreatedBy", fields: [createdBy], references: [id])
  createdAdmins        User[]              @relation("AdminCreatedBy")
  walletTransactions   WalletTransaction[]
  wishlistItems        WishlistItem[]
  qnas                 Qna[]

  @@map("users")
}

model Category {
  id                String     @id @default(uuid())
  name              String
  nameEn            String?    @map("name_en")
  slug              String     @unique
  slugEn            String?    @unique @map("slug_en")
  description       String?
  descriptionEn     String?    @map("description_en")
  parentId          String?    @map("parent_id")
  icon              String?
  image             String?
  sortOrder         Int        @default(0) @map("sort_order")
  isActive          Boolean    @default(true) @map("is_active")
  metaTitle         String?    @map("meta_title")
  metaTitleEn       String?    @map("meta_title_en")
  metaDescription   String?    @map("meta_description")
  metaDescriptionEn String?    @map("meta_description_en")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  parent            Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[] @relation("CategoryTree")
  products          Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  nameEn      String?
  slug        String    @unique
  logo        String?
  description String?
  products    Product[]

  @@map("brands")
}

model Product {
  id                String           @id @default(uuid())
  title             String
  titleEn           String?          @map("title_en")
  slug              String           @unique
  slugEn            String?          @unique @map("slug_en")
  description       String
  descriptionEn     String?          @map("description_en")
  weight            Float?
  dimensions        String?
  condition         ProductCondition @default(new)
  status            ProductStatus    @default(pending)
  isFeatured        Boolean          @default(false) @map("is_featured")
  isDigital         Boolean          @default(false) @map("is_digital")
  digitalFile       String?          @map("digital_file")
  viewCount         Int              @default(0) @map("view_count")
  saleCount         Int              @default(0) @map("sale_count")
  rating            Float            @default(0)
  reviewCount       Int              @default(0) @map("review_count")
  metaTitle         String?          @map("meta_title")
  metaTitleEn       String?          @map("meta_title_en")
  metaDescription   String?          @map("meta_description")
  metaDescriptionEn String?          @map("meta_description_en")
  productTable      Json?            @map("product_table")
  productTableEn    Json?            @map("product_table_en")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  sellerId          String           @map("seller_id")
  categoryId        String           @map("category_id")
  brandId           String?          @map("brand_id")
  cartItems         CartItem[]
  compareItems      CompareItem[]
  conversations     Conversation[]
  orderItems        OrderItem[]
  images            ProductImage[]
  variants          ProductVariant[]
  brand             Brand?           @relation(fields: [brandId], references: [id])
  category          Category         @relation(fields: [categoryId], references: [id])
  seller            User             @relation(fields: [sellerId], references: [id])
  reviews           Review[]
  wishlistItems     WishlistItem[]
  qnas              Qna[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model ProductVariant {
  id           String        @id @default(uuid())
  name         String
  nameEn       String?
  sku          String?       @unique
  price        Float?
  quantity     Int           @default(0)
  colorId      String?
  image        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  discountId   String?       @map("discount_id")
  productId    String        @map("product_id")
  attributes   Json?
  attributesEn Json?
  cartItems    CartItem[]
  orderItems   OrderItem[]
  discount     DiscountCode? @relation(fields: [discountId], references: [id], onDelete: Cascade)
  color        Color?        @relation(fields: [colorId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model Color {
  id              String           @id @default(uuid())
  name            String           @map("name")
  nameEn          String           @map("name_en")
  hexCode         String           @map("hex_code")
  slug            String           @map("slug")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  productVariants ProductVariant[]
}

model ProductImage {
  id              String         @id @default(uuid())
  url             String         @unique
  alt             String?
  useCase         ImageUseCase   @default(PRODUCT) @map("use_case")
  sortOrder       Int            @default(0) @map("sort_order")
  isMain          Boolean        @default(false) @map("is_main")
  createdAt       DateTime       @default(now()) @map("created_at")
  productId       String?        @map("product_id")
  reportsId       String?
  ticketMessageId String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reports         Reports?       @relation(fields: [reportsId], references: [id])
  ticketMessage   TicketMessage? @relation(fields: [ticketMessageId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model CartItem {
  id        String         @id @default(uuid())
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  userId    String         @map("user_id")
  productId String         @map("product_id")
  variantId String         @map("variant_id")
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

model Address {
  id         String   @id @default(uuid())
  title      String?
  fullName   String   @map("full_name")
  phone      String
  province   String
  city       String
  address    String
  postalCode String?  @map("postal_code")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique @map("order_number")
  status           OrderStatus     @default(pending)
  paymentStatus    PaymentStatus   @default(pending) @map("payment_status")
  paymentMethod    PaymentMethod?  @map("payment_method")
  paymentRef       String?         @map("payment_ref")
  subtotal         Float
  shippingCost     Float           @default(0) @map("shipping_cost")
  discountAmount   Float           @default(0) @map("discount_amount")
  commissionAmount Float           @default(0) @map("commission_amount")
  total            Float
  shippingAddress  String?         @map("shipping_address")
  shippingCity     String?         @map("shipping_city")
  shippingProvince String?         @map("shipping_province")
  shippingPostal   String?         @map("shipping_postal")
  shippingPhone    String?         @map("shipping_phone")
  shippingName     String?         @map("shipping_name")
  trackingCode     String?         @map("tracking_code")
  notes            String?
  sellerNotes      String?         @map("seller_notes")
  cancelledAt      DateTime?       @map("cancelled_at")
  deliveredAt      DateTime?       @map("delivered_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  userId           String          @map("user_id")
  addressId        String?         @map("address_id")
  discountId       String?         @map("discount_id")
  invoice          Invoice?
  items            OrderItem[]
  address          Address?        @relation(fields: [addressId], references: [id])
  discount         DiscountCode?   @relation(fields: [discountId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  payments         Payment[]
  refund           Refund?
  ticket           Ticket?
  trackingEvents   TrackingEvent[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  title       String
  price       Float
  quantity    Int
  total       Float
  image       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  orderId     String         @map("order_id")
  productId   String         @map("product_id")
  sellerId    String         @map("seller_id")
  sku         String
  variantName String
  variantId   String         @map("variant_id")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  seller      User           @relation(fields: [sellerId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model Payment {
  id           String        @id @default(uuid())
  amount       Float
  method       PaymentMethod
  status       PaymentStatus @default(pending)
  gatewayRef   String?       @map("gateway_ref")
  authority    String?
  errorMessage String?       @map("error_message")
  paidAt       DateTime?     @map("paid_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  orderId      String        @map("order_id")
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  amount        Float
  status        InvoiceStatus @default(pending)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  orderId       String        @unique @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

model Refund {
  id          String        @id @default(uuid())
  amount      Float
  reason      String
  status      InvoiceStatus @default(pending)
  processedAt DateTime?     @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  orderId     String        @unique @map("order_id")
  order       Order         @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  title      String?
  body       String
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  userId     String   @map("user_id")
  productId  String   @map("product_id")
  orderId    String?  @map("order_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model SellerReview {
  id         String   @id @default(uuid())
  rating     Int
  body       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  reviewerId String   @map("reviewer_id")
  sellerId   String   @map("seller_id")
  reviewer   User     @relation("SellerReviews", fields: [reviewerId], references: [id])
  seller     User     @relation("SellerReviewed", fields: [sellerId], references: [id])

  @@index([sellerId])
  @@map("seller_reviews")
}

model WishlistItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model CompareItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("compare_items")
}

model Conversation {
  id            String    @id @default(uuid())
  subject       String?
  lastMessage   String?   @map("last_message")
  lastMessageAt DateTime? @map("last_message_at")
  isRead        Boolean   @default(false) @map("is_read")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  productId     String?   @map("product_id")
  buyerId       String    @map("buyer_id")
  sellerId      String    @map("seller_id")
  buyer         User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  product       Product?  @relation(fields: [productId], references: [id])
  seller        User      @relation("ConversationSeller", fields: [sellerId], references: [id])
  messages      Message[]

  @@index([buyerId])
  @@index([sellerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  text           String
  isRead         Boolean      @default(false) @map("is_read")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  receiverId     String       @map("receiver_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Notification {
  id            String           @id @default(uuid())
  type          NotificationType
  title         String
  body          String
  link          String?
  referenceType String?          @map("reference_type")
  referenceId   String?          @map("reference_id")
  isRead        Boolean          @default(false) @map("is_read")
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  type          WalletTransactionType
  amount        Float
  balanceBefore Float                   @map("balance_before")
  balanceAfter  Float                   @map("balance_after")
  description   String?
  status        WalletTransactionStatus @default(completed)
  reference     String?
  createdAt     DateTime                @default(now()) @map("created_at")
  userId        String                  @map("user_id")
  user          User                    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("wallet_transactions")
}

model DiscountCode {
  id              String              @id @default(uuid())
  code            String              @unique
  type            DiscountType        @default(percentage)
  value           Float
  minOrderAmount  Float               @default(0) @map("min_order_amount")
  maxDiscount     Float?              @map("max_discount")
  usageLimit      Int                 @default(0) @map("usage_limit")
  usedCount       Int                 @default(0) @map("used_count")
  perUserLimit    Int                 @default(0) @map("per_user_limit")
  startsAt        DateTime            @map("starts_at")
  endsAt          DateTime            @map("ends_at")
  isActive        Boolean             @default(true) @map("is_active")
  description     String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  creatorId       String?             @map("creator_id")
  sellerId        String?             @map("seller_id")
  usages          DiscountCodeUsage[]
  creator         User?               @relation("DiscountCodeCreator", fields: [creatorId], references: [id])
  seller          User?               @relation(fields: [sellerId], references: [id])
  orders          Order[]
  productVariants ProductVariant[]

  @@map("discount_codes")
}

model DiscountCodeUsage {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now()) @map("created_at")
  discountCodeId String       @map("discount_code_id")
  userId         String       @map("user_id")
  orderId        String       @map("order_id")
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)

  @@index([discountCodeId])
  @@index([userId])
  @@map("discount_code_usages")
}

model ShippingMethod {
  id            String   @id @default(uuid())
  name          String
  nameEn        String?  @map("name_en")
  description   String?
  cost          Float    @default(0)
  freeThreshold Float?   @map("free_threshold")
  estimatedDays String?  @map("estimated_days")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("shipping_methods")
}

model BlogPost {
  id                String         @id @default(uuid())
  title             String
  titleEn           String?        @map("title_en")
  slug              String         @unique
  slugEn            String?        @unique @map("slug_en")
  excerpt           String?
  excerptEn         String?        @map("excerpt_en")
  content           String
  contentEn         String?        @map("content_en")
  image             String?
  tags              String?
  status            BlogPostStatus @default(draft)
  publishedAt       DateTime?      @map("published_at")
  viewCount         Int            @default(0) @map("view_count")
  metaTitle         String?        @map("meta_title")
  metaTitleEn       String?        @map("meta_title_en")
  metaDescription   String?        @map("meta_description")
  metaDescriptionEn String?        @map("meta_description_en")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  authorId          String         @map("author_id")
  author            User           @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model Banner {
  id         String         @id @default(uuid())
  title      String
  titleEn    String?        @map("title_en")
  subtitle   String?
  subtitleEn String?        @map("subtitle_en")
  image      String
  link       String?
  position   BannerPosition @default(home_top)
  isActive   Boolean        @default(true) @map("is_active")
  sortOrder  Int            @default(0) @map("sort_order")
  startsAt   DateTime?      @map("starts_at")
  endsAt     DateTime?      @map("ends_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@map("banners")
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("string")

  @@map("site_settings")
}

model OtpCode {
  id        String     @id @default(uuid())
  contact   String
  code      String
  type      OtpType
  purpose   OtpPurpose @default(auth)
  used      Boolean    @default(false)
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([contact])
  @@index([expiresAt])
  @@map("otp_codes")
}

model TrackingEvent {
  id          String         @id @default(uuid())
  status      TrackingStatus
  location    String?
  description String
  createdAt   DateTime       @default(now()) @map("created_at")
  orderId     String         @map("order_id")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("tracking_events")
}

model SellerRating {
  id             String   @id @default(uuid())
  avgRating      Float    @default(0) @map("avg_rating")
  totalReviews   Int      @default(0) @map("total_reviews")
  responseRate   Float    @default(100) @map("response_rate")
  responseTime   Float    @default(0) @map("response_time")
  onTimeDelivery Float    @default(100) @map("on_time_delivery")
  productQuality Float    @default(5) @map("product_quality")
  communication  Float    @default(5) @map("communication")
  updatedAt      DateTime @updatedAt @map("updated_at")
  sellerId       String   @unique @map("seller_id")
  seller         User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_ratings")
}

model Ticket {
  id             String          @id @default(uuid())
  status         TicketStatus    @default(PENDING)
  priority       TicketPriority
  title          String
  trackingCode   String
  isUserRead     Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  userId         String          @map("user_id")
  orderId        String?         @unique @map("order_id") // ✅ unique می‌ماند
  ticketMessages TicketMessage[]
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("tickets")
}

model TicketMessage {
  id        String         @id @default(cuid())
  content   String
  ticketId  String
  senderId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  images    ProductImage[]
  sender    User           @relation(fields: [senderId], references: [id])
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("ticket_messages")
}

model Reports {
  id           String         @id @default(uuid())
  nameSeller   String?
  content      String
  title        String
  orderCode    String?
  trackingCode String?
  status       ReportsStatus  @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  images       ProductImage[]

  @@index([status])
  @@map("reports")
}

model Qna {
  id        String         @id @default(uuid())
  content   String
  role      UserRole       @default(buyer)
  status    ReviewApproval @default(pending)
  userId    String
  parentId  String?
  productId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  parent  Qna?    @relation("QnaReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Qna[]   @relation("QnaReplies")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
}

